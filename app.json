{
  "expo": {
    "name": "Mileage Trips",
    "slug": "mileage-trips",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mileage Trips to attach receipt and company logo photos."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.markkos.mileagetrips"
    },
    "android": {
      "package": "com.markkos.mileagetrips"
    }
  }
}
